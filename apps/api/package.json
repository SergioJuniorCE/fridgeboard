{
  "name": "@yoggan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:access": "pnpm build && node --env-file=../../.env --test test/access.integration.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.3.0",
    "@hono/node-server": "^1.13.0",
    "@yoggan/db": "workspace:*",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^186.0.0",
    "hono": "^4.7.0",
    "mysql2": "^3.14.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
